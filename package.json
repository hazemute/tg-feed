    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.2",
    "input-otp": "^1.4.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.525.0",
    "msedge-tts": "^2.0.7",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "pg": "8",
