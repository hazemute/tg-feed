{
  "name": "tg-swipe",
  "version": "5.97.0",
  "private": true,
  "scripts": {
    "dev": "bun next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "bunx prisma db push --schema prisma/schema.prisma --accept-data-loss",
    "db:generate": "bunx prisma generate --schema prisma/schema.prisma",
    "db:migrate": "bunx prisma migrate dev --schema prisma/schema.prisma",
    "db:reset": "bunx prisma migrate reset --schema prisma/schema.prisma",
    "db:local:generate": "bunx prisma generate --schema prisma/schema.local.prisma",
    "db:local:push": "bunx prisma db push --schema prisma/schema.local.prisma --accept-data-loss",
    "cleanup:vercel": "bun scripts/vercel-cleanup.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
