// TG-Feed — каноническая Prisma-схема (PostgreSQL / Supabase).
// Единственная БД для локальной разработки и прода: Supabase Postgres.
// Изменение моделей: bun run db:push (db push по этой схеме) и обновить
// supabase/schema.sql — структура облачной БД должна совпадать.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Telegram user (id from initData) or demo user (id from deviceId)
model User {
  id            String   @id // "tg_<uid>" | "guest_<deviceId>"
  username      String?
  firstName     String?
  lastName      String?
  photoUrl      String? // http URL или tgfile:<file_id> (аватар через /api/avatar)
  isGuest       Boolean  @default(true) @map("isDemo")
  isPremium     Boolean  @default(false) // Telegram Premium (из initData)
  languageCode  String? // язык клиента Telegram (IETF-код)
  categories    String   @default("[]") // JSON array of category slugs (interests)
  bypassMaintenance Boolean @default(false) // допуск в миниапп во время техработ (кроме админов из ADMIN_TG_IDS)
  lastSeenNotifiedAt DateTime? // граница «прочитанных» уведомлений (экран «Уведомления»)
  createdAt     DateTime @default(now())

  likes         Like[]
  views         PostView[]
  subscriptions Subscription[]
  channels      Channel[]      @relation("addedChannels")
  claimed       Channel[]      @relation("claimedChannels")
  bookmarks     Bookmark[]
  advertiser    AdvertiserAccount?
  campaigns     AdCampaign[]
  translations  TranslationLog[]
}

model Category {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  emoji    String
  order    Int    @default(0)

  channels Channel[]
}

model Channel {
  id               String    @id @default(cuid())
  tgId             String    @unique // Telegram channel id (synthetic for seeds)
  title            String
  username         String    @unique // without @
  description      String?
  avatarColor      String    @default("#3390ec")
  photoFileId      String? // file_id аватарки канала (Bot API getChat) → /api/avatar/c_<id>
  avatarVideoUrl   String? // анимированная аватарка (видео с лендинга t.me) — играет как в Telegram
  avatarFetchedAt  DateTime? // когда последний раз обновляли аватарку (TTL 7 дней)
  membersCount     Int? // реальное число подписчиков из Bot API getChatMemberCount
  membersFetchedAt DateTime? // когда последний раз обновляли счётчик (TTL 7 дней)
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  isPremium        Boolean   @default(false)
  premiumUntil     DateTime?
  status           String    @default("active") // active | moderation
  subscribersCount Int       @default(0)
  clicksCount      Int       @default(0) // клики по кнопке [+] подписки
  // === «Мой канал»: владение и гибкие настройки показа ===
  claimedById      String? // пользователь, доказавший владение каналом
  claimedBy        User?     @relation("claimedChannels", fields: [claimedById], references: [id])
  claimedAt        DateTime?
  // Тизер-режим: none — посты целиком; cut — первые N символов + «Читать в канале»;
  // blur — весь текст виден, но размазан до подписки (жёстче конверсия)
  teaserMode       String    @default("none")
  teaserLimit      Int       @default(160) // сколько символов показывать в режиме cut
  addedById        String?
  addedBy          User?     @relation("addedChannels", fields: [addedById], references: [id])
  createdAt        DateTime  @default(now())

  posts            Post[]
  subscriptions    Subscription[]
  campaigns        AdCampaign[]

  @@index([status])
}

model Post {
  id          String   @id @default(cuid())
  tgKey       String   @unique // "<username>:<messageId>"
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  text        String   @default("") // markdown-lite: **bold**, __italic__, `code`, ||спойлер||, > цитата, [текст](url)
  mediaUrl    String?
  // image | video | gif | sticker | audio | voice | file | poll | link | none
  mediaType   String   @default("image")
  mediaMeta   String? // JSON: имя/размер файла, длительность, варианты опроса, превью ссылки и т.п.
  gallery     String? // JSON array — дополнительные медиа (карусель фото)
  link        String? // original t.me link
  viewsCount  Int      @default(0)
  viewsTg     Int? // просмотры из оригинального канала Telegram (t.me/s) — обновляются при парсинге
  reactionsTg Int      @default(0) // сумма всех реакций исходного поста (t.me/s) — обновляются при парсинге
  likesCount  Int      @default(0)
  aiSummary   String? // кэш AI-саммари (JSON array из 3 пунктов)
  translations String? // кэш переводов: {"en":{"text":"…","at":"ISO"}}
  ttsAudio     String? // озвучка поста (base64 mp3, кэш; генерируется по запросу)
  ttsAt        DateTime? // когда сгенерирована озвучка (для инвалидации при смене текста)
  publishedAt DateTime
  notifiedAt  DateTime? // момент рассылки уведомления подписчикам (Bot API); null — не рассылался

  embedTried  Boolean  @default(false) // бэкфилл медиа через t.me/<u>/<id>?embed=1 уже пробовали
  likedBy     Like[]
  viewedBy    PostView[]
  bookmarkedBy Bookmark[]

  @@index([channelId, publishedAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model PostView {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  hidden    Boolean  @default(false) // скрыть канал из общей ленты
  notify    Boolean  @default(true)  // колокольчик: true — все уведомления, false — без звука
  notInterestedAt DateTime? // «Не интересно»: канал взвешивается вниз/убирается из ленты
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Bookmark {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  readAt    DateTime? // когда пользователь открыл сохранённый пост (непрочитанные — без readAt)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model Ad {
  id         String   @id @default(cuid())
  title      String
  body       String
  ctaLabel   String   @default("Перейти")
  link       String
  imageUrl   String?
  isActive   Boolean  @default(true)
  impressions Int     @default(0) // показы в ленте (счётчик за всё время)
  clicks     Int      @default(0) // клики по CTA (счётчик за всё время)
  createdAt  DateTime @default(now())

  stats      AdStat[]
}

// === CPA-реклама: платят за уникальные переходы, деньги списываются с
// предоплаченного баланса (эскроу) — рекламодатель физически не может
// «не оплатить»: кампания крутится ровно до исчерпания внесённого бюджета.
model AdCampaign {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channelId      String? // продвигаемый канал (если есть в базе)
  channel        Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  title          String
  body           String
  ctaLabel       String    @default("Подписаться")
  link           String
  imageUrl       String?
  costPerClickKop Int      @default(300) // цена уникального перехода, копейки (≥100)
  budgetKop      Int       @default(0) // внесённый бюджет, копейки
  spentKop       Int       @default(0) // списано за подтверждённые клики
  impressions    Int       @default(0)
  clicks         Int       @default(0) // оплаченные уникальные клики
  rawClicks      Int       @default(0) // все клики (для аналитики накрутки)
  status         String    @default("moderation") // moderation | active | paused | completed | rejected
  note           String? // комментарий модератора (причина отказа и т.п.)
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  clicksLog      CampaignClick[]
  stats          CampaignStat[]

  @@index([status])
}

// Баланс рекламодателя (эскроу): пополнение админом после оплаты, списание
// за уникальные клики кампаний. userId = @id — один кошелёк на пользователя.
model AdvertiserAccount {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKop     Int      @default(0)
  topupsTotalKop Int      @default(0)
  spentTotalKop  Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// Анти-накрутка: один оплаченный клик на пару (кампания, пользователь) в сутки.
// Повторные клики того же пользователя не тарифицируются.
model CampaignClick {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  lastBilledAt DateTime @default(now()) // день последнего тарифицируемого клика
  billedCount  Int      @default(1)

  @@unique([campaignId, userId])
}

// Дневная статистика кампании (аналог AdStat)
model CampaignStat {
  id          String @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  day         String // YYYY-MM-DD (UTC)
  impressions Int    @default(0)
  clicks      Int    @default(0)
  spentKop    Int    @default(0)

  @@unique([campaignId, day])
  @@index([day])
}

// Журнал переводов постов (анти-абьюз и статистика; кэш текста — в Post.translations)
model TranslationLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String
  srcLang   String
  createdAt DateTime @default(now())

  @@index([postId])
}

// Дневная аналитика рекламы (одна строка на рекламу в день): CTR и динамика
// для рекламодателей. Счётчики увеличиваются атомарным upsert.
model AdStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  day         String // YYYY-MM-DD (UTC)
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([adId, day])
  @@index([day])
}

// Клики по #хэштегам в постах — источник трендов «Сейчас обсуждают»
model HashtagClick {
  id        String   @id @default(cuid())
  tag       String // без решётки, lowercase
  userId    String? // кто кликнул (для анти-спама и аналитики)
  createdAt DateTime @default(now())

  @@index([tag, createdAt])
}

// Системные настройки (key-value): флаг техработ и прочее. Redis — рантайм,
// эта таблица — зеркало для долговечности и восстановления после сбоя кэша.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Премиум-эмодзи Telegram (custom emoji): резолвер Bot API.
// id — custom_emoji_id из разметки t.me/s (<tg-emoji emoji-id="…">);
// fileId — файл анимированного видео-стикера (webm) для /api/emoji/[id].
// kind: 'video' (анимированный webm) | 'static' (только статичная картинка)
model CustomEmoji {
  id        String   @id
  kind      String   @default("static")
  fileId    String?
  fetchedAt DateTime @updatedAt
}

// Заготовка эквайринга ЮKassa: платёж, созданный рекламодателем.
// После подключения эквайринга здесь появится providerPaymentId и
// confirmationUrl, а статус поведёт вебхук ЮKassa (pending → succeeded).
model PendingPayment {
  id                String   @id @default(cuid())
  userId            String
  amountKop         Int
  status            String   @default("pending") // pending | succeeded | canceled
  provider          String   @default("yookassa")
  providerPaymentId String?
  confirmationUrl   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}
