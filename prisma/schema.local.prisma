// TG-Feed — Prisma schema (SQLite) — ТОЛЬКО для локальной разработки в песочнице.
// Каноническая схема проекта (Supabase/PostgreSQL) — prisma/schema.prisma;
// модели в двух файлах должны оставаться идентичными (сверка при изменениях).
// Клиент для локального рантайма генерится из ЭТОГО файла: bun run db:generate
// Note: SQLite has no native arrays/enums → JSON strings + status fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Telegram user (id from initData) or demo user (id from deviceId)
model User {
  id            String   @id // "tg_<uid>" | "guest_<deviceId>"
  username      String?
  firstName     String?
  lastName      String?
  photoUrl      String?
  isGuest       Boolean  @default(true) // в БД колонка исторически isDemo
  isPremium     Boolean  @default(false)
  languageCode  String?
  bypassMaintenance Boolean @default(false)
  categories    String   @default("[]") // JSON array of category slugs (interests)
  lastSeenNotifiedAt DateTime? // граница «прочитанных» уведомлений (экран «Уведомления»)
  bannedAt      DateTime? // бан: null — активен; API отвечает 403 banned
  banReason     String?   // причина бана (видна админу)
  tier          String   @default("free") // free | plus | pro (Snap Plus / Snap Pro)
  tierUntil     DateTime? // срок действия оплаченного тира
  badges        String   @default("[]") // v5.19: JSON-массив слагов бейджей (lib/badges.ts)
  profilePalette String  @default("crimson") // v5.27: обложка профиля (lib/profile-style.ts)
  profileBg      String  @default("none") // v5.27: фон обложки (узор/анимация)
  profileFrame   String  @default("none") // v5.27: рамка аватара
  balanceKop     Int      @default(0) // рубли, в копейках
  swipes         Int      @default(0) // свайпы (валюта ИИ, конвертируется в рубли)
  createdAt     DateTime @default(now())

  @@index([tier])
  @@index([createdAt])

  likes         Like[]
  uploads       Upload[]
  views         PostView[]
  subscriptions Subscription[]
  channelMutes  ChannelMute[]
  channels      Channel[]
  claimedChannels Channel[] @relation("claimedChannels")
  bookmarks     Bookmark[]
  comments      Comment[]
  notifications Notification[]
  supportThreads SupportThread[]
  advertiser    AdvertiserAccount?
  campaigns     AdCampaign[]
  translations  TranslationLog[]
  balanceLogs   BalanceLog[]
}

model Category {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  emoji    String
  order    Int    @default(0)

  channels Channel[]
}

model Channel {
  id               String    @id @default(cuid())
  tgId             String    @unique // Telegram channel id (synthetic for seeds)
  title            String
  username         String    @unique // without @
  description      String?
  avatarColor      String    @default("#3390ec")
  photoFileId      String?
  avatarUrl        String?
  avatarHash       String?
  avatarVideoUrl   String?
  avatarFetchedAt  DateTime?
  membersCount     Int?
  membersFetchedAt DateTime?
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  isPremium        Boolean   @default(false)
  premiumUntil     DateTime?
  verified         Boolean   @default(false)
  status           String    @default("active") // active | moderation
  subscribersCount Int       @default(0)
  clicksCount      Int       @default(0) // клики по кнопке [+] подписки
  claimedById      String?
  claimedBy        User?     @relation("claimedChannels", fields: [claimedById], references: [id])
  claimedAt        DateTime?
  ctaLabel      String? // Snap Pro: текст CTA-кнопки в раскрытом посте
  ctaUrl        String? // Snap Pro: ссылка CTA-кнопки (https)
  styleProfile  String? // Snap Pro: слепок стиля ИИ-ассистента (JSON)
  styleAt       DateTime? // Snap Pro: когда последний раз сканировали стиль
  teaserMode       String    @default("none")
  teaserLimit      Int       @default(160)
  addedById        String?
  addedBy          User?     @relation(fields: [addedById], references: [id])
  createdAt        DateTime  @default(now())

  posts            Post[]
  subscriptions    Subscription[]
  mutedBy     ChannelMute[]
  campaigns   AdCampaign[]
}

model Post {
  id          String   @id @default(cuid())
  tgKey       String   @unique // "<username>:<messageId>"
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  text        String   @default("")
  mediaUrl    String?
  mediaType   String   @default("image") // image | video
  mediaMeta   String? // JSON: имя/размер файла, длительность, варианты опроса, превью ссылки и т.п.
  gallery     String? // JSON array — дополнительные медиа (карусель)
  link        String? // original t.me link
  viewsCount  Int      @default(0)
  viewsTg     Int? // просмотры из оригинального канала (t.me/s)
  reactionsTg Int      @default(0) // сумма реакций исходного поста (t.me/s)
  likesCount  Int      @default(0)
  commentsCount Int    @default(0) // денормализованный счётчик комментариев
  hotScore    Float    @default(0) // «температура» поста
  aiSummary   String? // кэш AI-саммари (JSON array из 3 пунктов)
  aiFlag      String? // вердикт ИИ-модерации: ok | junk | nsfw | spam (null — не модерирован)
  aiFlagAt    DateTime? // когда вынесен вердикт
  translations String? // кэш переводов: {"ru":{"text":"…","at":"ISO"}}
  ttsAudio    String?  // озвучка поста (base64 mp3)
  ttsAt       DateTime?
  publishedAt DateTime
  notifiedAt  DateTime? // момент рассылки уведомления подписчикам (Bot API)
  promotedAt  DateTime? // когда автор протолкнул пост в ленту (Snap Pro ≤7/нед)
  embedTried  Boolean  @default(false) // бэкфилл медиа через t.me embed уже пробовали

  likedBy     Like[]
  viewedBy    PostView[]
  bookmarkedBy Bookmark[]
  comments    Comment[]

  // v5.44 (скорость): срезы ленты по времени, категории/тренды, промо-посты (page 0)
  @@index([channelId, publishedAt])
  @@index([publishedAt])
  @@index([promotedAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  // v5.44 (скорость): счётчики по посту + «пульс» трендов за 24ч
  @@index([postId])
  @@index([createdAt])
}

model PostView {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  dwellMs   Int      @default(0) // суммарное время поста на экране — сигнал интереса

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  // v5.44 (скорость): «пульс» трендов — count просмотров за 24ч
  @@index([createdAt])
  // v5.46 (розыгрыши): прогресс задания «пролистай X свайпов»
  @@index([userId, createdAt])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  hidden    Boolean  @default(false) // скрыть канал из общей ленты
  notify    Boolean  @default(true)  // колокольчик: true — все уведомления, false — без звука
  notInterestedAt DateTime? // «Не интересно»: канал вниз/вне ленты
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelMute {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Bookmark {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  readAt    DateTime? // когда пользователь открыл сохранённый пост (непрочитанные — без readAt)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  // v5.44 (скорость): подзапрос COUNT bookmarksCount в SQL-странице ленты — на каждый пост
  @@index([postId])
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  body        String
  ctaLabel    String   @default("Перейти")
  link        String
  imageUrl    String?
  isActive    Boolean  @default(true)
  impressions Int      @default(0) // показы в ленте (счётчик за всё время)
  clicks      Int      @default(0) // клики по CTA (счётчик за всё время)
  createdAt   DateTime @default(now())

  stats       AdStat[]
}

// Дневная аналитика рекламы (одна строка на рекламу в день): CTR и динамика
// для рекламодателей. Счётчики увеличиваются атомарным upsert.
model AdStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  day         String // YYYY-MM-DD (UTC)
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([adId, day])
  @@index([day])
}

// Клики по #хэштегам в постах — источник трендов «Сейчас обсуждают»
model HashtagClick {
  id        String   @id @default(cuid())
  tag       String // без решётки, lowercase
  userId    String? // кто кликнул (для анти-спама и аналитики)
  createdAt DateTime @default(now())

  @@index([tag, createdAt])
  // v5.44 (скорость): «пульс» трендов — count кликов за 24ч
  @@index([createdAt])
}

// Загруженные пользователями картинки (чат поддержки/предложка)
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mime      String   // image/webp | image/jpeg | image/png
  data      String   // base64
  bytes     Int
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

// === v5.15: синхронизация с прода (комментарии, лайки, уведы, эмодзи, поддержка) ===

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  parentId      String?
  parent        Comment?  @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("commentThread")
  replyToUserId String?
  replyToName   String?

  likesCount   Int @default(0)
  repliesCount Int @default(0)
  likedBy      CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([postId, likesCount])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    @default("system")
  title           String
  body            String?
  postId          String?
  commentId       String?
  channelUsername String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  // v5.44 (скорость): бейдж непрочитанных поллится каждые ~20-45с
  @@index([userId, readAt])
}

model CustomEmoji {
  id        String   @id
  kind      String   @default("static")
  animated  Boolean  @default(false)
  fileId    String?
  fetchedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SupportThread {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("ai")
  kind          String   @default("support")
  topic         String?
  unreadAdmin   Int      @default(0)
  unreadUser    Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    String
  text      String
  images    String?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// === Реклама/кампании (v5.15 sync) ===

model AdCampaign {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  title          String
  body           String
  ctaLabel       String    @default("Подписаться")
  link           String
  imageUrl       String?
  costPerClickKop Int      @default(300)
  budgetKop      Int       @default(0)
  spentKop       Int       @default(0)
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  rawClicks      Int       @default(0)
  status         String    @default("moderation")
  note           String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  clicksLog      CampaignClick[]
  stats          CampaignStat[]

  @@index([status])
}

model AdvertiserAccount {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKop     Int      @default(0)
  topupsTotalKop Int      @default(0)
  spentTotalKop  Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model CampaignClick {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  lastBilledAt DateTime @default(now())
  billedCount  Int      @default(1)

  @@unique([campaignId, userId])
}

model CampaignStat {
  id          String @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  day         String
  impressions Int    @default(0)
  clicks      Int    @default(0)
  spentKop    Int    @default(0)

  @@unique([campaignId, day])
  @@index([day])
}

model TranslationLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String
  srcLang   String
  createdAt DateTime @default(now())

  @@index([postId])
}

// Вход на сайт через Telegram-бота (каноническая модель из schema.prisma):
// гость жмёт «Вход по Telegram» → бот /start login_<id> → callback подтверждает
// попытку, сайт (опрос) выдаёт JWT-сессию реального TG-аккаунта.
model LoginAttempt {
  id          String    @id // случайный токен из ссылки-приглашения
  status      String    @default("pending") // pending | confirmed | used
  tgUserJson  String?   // снимок tg-user из callback_query (id/username/имя/фото)
  confirmedAt DateTime?
  expiresAt   DateTime // 15 минут на подтверждение
  createdAt   DateTime  @default(now())

  @@index([status, expiresAt])
}

// ИИ-поиск: журнал для лимита бесплатного тира (3/день)
model AiSearchLog {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Журнал действий администратора (аудит панели) — идентично schema.prisma
model AdminLog {
  id        String   @id @default(cuid())
  action    String // tier_grant | tier_revoke | tier_extend | ban | unban | swipes | premium_on | premium_off | bypass_on | bypass_off | ops
  target    String // userId / @username / пост
  meta      String? // JSON-снимок параметров (tier, days, reason…)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

// Платежи (на проде — ЮKassa/Stars/TON; локально не используется, но нужен для tsc)
model PendingPayment {
  id                String   @id @default(cuid())
  userId            String
  amountKop         Int
  status            String   @default("pending")
  provider          String   @default("yookassa")
  purpose           String   @default("balance") // balance | plus_month | plus_year | pro_month | pro_year
  providerPaymentId String?
  confirmationUrl   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model BotEmoji {
  slot          String   @id
  emoji         String
  customEmojiId String
  updatedAt     DateTime @updatedAt
}

model BotSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BalanceLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // topup | convert | ai_spend | purchase | ad_campaign | refund | admin
  currency  String   @default("rub") // rub | swp
  amount    Int // знаковый: + зачисление, − списание
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Giveaway {
  id          String    @id @default(cuid())
  title       String
  text        String    @default("") // markdown-lite описание (условия)
  prizes      String    @default("[]") // JSON: [{kind:'swipes'|'rub'|'tier'|'custom', amount, period?, winners, label}]
  channels    String    @default("[]") // JSON: ["SnapTeamDev", "sponsor_channel"]
  buttonStyle String    @default("primary") // primary | success | danger
  buttonEmoji String    @default("🎉")
  buttonEmojiId String  @default("") // custom_emoji_id для icon_custom_emoji_id
  startAt     DateTime  @default(now()) // публикация поста (или сразу, если в прошлом)
  endAt       DateTime // окончание приёма заявок → розыгрыш
  status      String    @default("draft") // draft | scheduled | active | finished | cancelled
  chatId      String? // канал публикации (напр. -100… или @username)
  messageId   Int? // пост с кнопкой (для realtime-обновления счётчика)
  winners     String? // JSON: [{userId, name, tgId?, prizeIndex, tickets?}] после финализации
  winnersMessageId Int? // пост с победителями
  createdAt   DateTime  @default(now())

  // ---- v5.46: билетная система ----
  tasks       String    @default("[]") // JSON задания: [{kind, enabled, tickets, swipeGoal?, referralGoal?, boostChannel?, label?}]
  promoCode   String? // секретный промокод (задание promo)
  losersRewardSwipes Int @default(0) // утешительные свайпы проигравшим (0 = выкл)
  photoFileId String? // file_id фото поста розыгрыша (sendPhoto)

  entries     GiveawayEntry[]
  tickets     GiveawayTicket[]

  @@index([status, endAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String // User.id (tg_<uid>)
  tgId       String? // числовой id Telegram (ссылка tg://user?id=)
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())

  // ---- v5.46: билетная система ----
  ticketsCount Int    @default(0) // баланс билетов = вес во взвешенном рандоме
  tasksDone    String @default("[]") // JSON: [{task, tickets, at}]

  tickets    GiveawayTicket[]

  @@unique([giveawayId, userId])
  @@index([giveawayId, createdAt])
  @@index([giveawayId, ticketsCount])
}

// Аудит билетов: повторная выдача того же задания невозможна (unique)
model GiveawayTicket {
  id         String         @id @default(cuid())
  giveawayId String
  giveaway   Giveaway       @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  entryId    String?
  entry      GiveawayEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  userId     String
  task       String // activity | promo | referral | boost | manual
  tickets    Int            @default(1)
  note       String?
  createdAt  DateTime       @default(now())

  @@unique([giveawayId, userId, task])
  @@index([userId, createdAt])
}

// Реферальные приглашения (глобальные): /start ref_<referrerTgId> в боте;
// activatedAt — когда друг впервые открыл Mini App
model GiveawayReferral {
  id             String    @id @default(cuid())
  referrerUserId String
  invitedTgId    String
  invitedUserId  String?
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([referrerUserId, invitedTgId])
  @@index([referrerUserId, activatedAt])
}
