// TG-Feed — Prisma schema (SQLite) — ТОЛЬКО для локальной разработки в песочнице.
// Каноническая схема проекта (Supabase/PostgreSQL) — prisma/schema.prisma;
// модели в двух файлах должны оставаться идентичными (сверка при изменениях).
// Клиент для локального рантайма генерится из ЭТОГО файла: bun run db:generate
// Note: SQLite has no native arrays/enums → JSON strings + status fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Telegram user (id from initData) or demo user (id from deviceId)
model User {
  id            String   @id // "tg_<uid>" | "guest_<deviceId>"
  username      String?
  firstName     String?
  lastName      String?
  photoUrl      String?
  isGuest       Boolean  @default(true) // в БД колонка исторически isDemo
  isPremium     Boolean  @default(false)
  languageCode  String?
  bypassMaintenance Boolean @default(false)
  categories    String   @default("[]") // JSON array of category slugs (interests)
  lastSeenNotifiedAt DateTime? // граница «прочитанных» уведомлений (экран «Уведомления»)
  bannedAt      DateTime? // бан: null — активен; API отвечает 403 banned
  banReason     String?   // причина бана (видна админу)
  createdAt     DateTime @default(now())

  likes         Like[]
  uploads       Upload[]
  views         PostView[]
  subscriptions Subscription[]
  channelMutes  ChannelMute[]
  channels      Channel[]
  claimedChannels Channel[] @relation("claimedChannels")
  bookmarks     Bookmark[]
  comments      Comment[]
  notifications Notification[]
  supportThreads SupportThread[]
  advertiser    AdvertiserAccount?
  campaigns     AdCampaign[]
  translations  TranslationLog[]
}

model Category {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  emoji    String
  order    Int    @default(0)

  channels Channel[]
}

model Channel {
  id               String    @id @default(cuid())
  tgId             String    @unique // Telegram channel id (synthetic for seeds)
  title            String
  username         String    @unique // without @
  description      String?
  avatarColor      String    @default("#3390ec")
  photoFileId      String?
  avatarUrl        String?
  avatarHash       String?
  avatarVideoUrl   String?
  avatarFetchedAt  DateTime?
  membersCount     Int?
  membersFetchedAt DateTime?
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  isPremium        Boolean   @default(false)
  premiumUntil     DateTime?
  verified         Boolean   @default(false)
  status           String    @default("active") // active | moderation
  subscribersCount Int       @default(0)
  clicksCount      Int       @default(0) // клики по кнопке [+] подписки
  claimedById      String?
  claimedBy        User?     @relation("claimedChannels", fields: [claimedById], references: [id])
  claimedAt        DateTime?
  teaserMode       String    @default("none")
  teaserLimit      Int       @default(160)
  addedById        String?
  addedBy          User?     @relation(fields: [addedById], references: [id])
  createdAt        DateTime  @default(now())

  posts            Post[]
  subscriptions    Subscription[]
  mutedBy     ChannelMute[]
  campaigns   AdCampaign[]
}

model Post {
  id          String   @id @default(cuid())
  tgKey       String   @unique // "<username>:<messageId>"
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  text        String   @default("")
  mediaUrl    String?
  mediaType   String   @default("image") // image | video
  mediaMeta   String? // JSON: имя/размер файла, длительность, варианты опроса, превью ссылки и т.п.
  gallery     String? // JSON array — дополнительные медиа (карусель)
  link        String? // original t.me link
  viewsCount  Int      @default(0)
  viewsTg     Int? // просмотры из оригинального канала (t.me/s)
  reactionsTg Int      @default(0) // сумма реакций исходного поста (t.me/s)
  likesCount  Int      @default(0)
  commentsCount Int    @default(0) // денормализованный счётчик комментариев
  hotScore    Float    @default(0) // «температура» поста
  aiSummary   String? // кэш AI-саммари (JSON array из 3 пунктов)
  aiFlag      String? // вердикт ИИ-модерации: ok | junk | nsfw | spam (null — не модерирован)
  aiFlagAt    DateTime? // когда вынесен вердикт
  translations String? // кэш переводов: {"ru":{"text":"…","at":"ISO"}}
  ttsAudio    String?  // озвучка поста (base64 mp3)
  ttsAt       DateTime?
  publishedAt DateTime
  notifiedAt  DateTime? // момент рассылки уведомления подписчикам (Bot API)

  likedBy     Like[]
  viewedBy    PostView[]
  bookmarkedBy Bookmark[]
  comments    Comment[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostView {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  dwellMs   Int      @default(0) // суммарное время поста на экране — сигнал интереса

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  hidden    Boolean  @default(false) // скрыть канал из общей ленты
  notify    Boolean  @default(true)  // колокольчик: true — все уведомления, false — без звука
  notInterestedAt DateTime? // «Не интересно»: канал вниз/вне ленты
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelMute {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Bookmark {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  readAt    DateTime? // когда пользователь открыл сохранённый пост (непрочитанные — без readAt)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  body        String
  ctaLabel    String   @default("Перейти")
  link        String
  imageUrl    String?
  isActive    Boolean  @default(true)
  impressions Int      @default(0) // показы в ленте (счётчик за всё время)
  clicks      Int      @default(0) // клики по CTA (счётчик за всё время)
  createdAt   DateTime @default(now())

  stats       AdStat[]
}

// Дневная аналитика рекламы (одна строка на рекламу в день): CTR и динамика
// для рекламодателей. Счётчики увеличиваются атомарным upsert.
model AdStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  day         String // YYYY-MM-DD (UTC)
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([adId, day])
  @@index([day])
}

// Клики по #хэштегам в постах — источник трендов «Сейчас обсуждают»
model HashtagClick {
  id        String   @id @default(cuid())
  tag       String // без решётки, lowercase
  userId    String? // кто кликнул (для анти-спама и аналитики)
  createdAt DateTime @default(now())

  @@index([tag, createdAt])
}

// Загруженные пользователями картинки (чат поддержки/предложка)
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mime      String   // image/webp | image/jpeg | image/png
  data      String   // base64
  bytes     Int
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

// === v5.15: синхронизация с прода (комментарии, лайки, уведы, эмодзи, поддержка) ===

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  parentId      String?
  parent        Comment?  @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("commentThread")
  replyToUserId String?
  replyToName   String?

  likesCount   Int @default(0)
  repliesCount Int @default(0)
  likedBy      CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([postId, likesCount])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    @default("system")
  title           String
  body            String?
  postId          String?
  channelUsername String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
}

model CustomEmoji {
  id        String   @id
  kind      String   @default("static")
  animated  Boolean  @default(false)
  fileId    String?
  fetchedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SupportThread {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("ai")
  kind          String   @default("support")
  topic         String?
  unreadAdmin   Int      @default(0)
  unreadUser    Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    String
  text      String
  images    String?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// === Реклама/кампании (v5.15 sync) ===

model AdCampaign {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  title          String
  body           String
  ctaLabel       String    @default("Подписаться")
  link           String
  imageUrl       String?
  costPerClickKop Int      @default(300)
  budgetKop      Int       @default(0)
  spentKop       Int       @default(0)
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  rawClicks      Int       @default(0)
  status         String    @default("moderation")
  note           String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  clicksLog      CampaignClick[]
  stats          CampaignStat[]

  @@index([status])
}

model AdvertiserAccount {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKop     Int      @default(0)
  topupsTotalKop Int      @default(0)
  spentTotalKop  Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model CampaignClick {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  lastBilledAt DateTime @default(now())
  billedCount  Int      @default(1)

  @@unique([campaignId, userId])
}

model CampaignStat {
  id          String @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  day         String
  impressions Int    @default(0)
  clicks      Int    @default(0)
  spentKop    Int    @default(0)

  @@unique([campaignId, day])
  @@index([day])
}

model TranslationLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String
  srcLang   String
  createdAt DateTime @default(now())

  @@index([postId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
